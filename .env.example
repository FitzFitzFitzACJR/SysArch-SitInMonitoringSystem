# Copy to .env and adjust. Never commit .env.

# --- Database ---------------------------------------------------------------
# App connection (use the pooled URL on Neon/Supabase).
DATABASE_URL="postgresql://ccs:ccs@localhost:5432/ccs_sitin"
# Migrations connection (direct, non-pooled URL on Neon/Supabase). Optional locally.
DIRECT_URL=""

# --- Auth -------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-me-with-a-long-random-string"
# Public base URL, used in password-reset links.
APP_URL="http://localhost:3200"

# --- Seed -------------------------------------------------------------------
# Initial super admin. They are forced to change the password on first login.
SEED_ADMIN_ID_NUMBER="admin"
SEED_ADMIN_EMAIL="admin@ccs.local"
SEED_ADMIN_PASSWORD="ChangeMe!2026"

# Demo data (a lab staff account + sample students). Set to "false" in production.
SEED_DEMO="true"
# Password shared by all demo accounts (staff: "staff", students: "2024-0001".."2024-0005").
SEED_DEMO_PASSWORD="Demo!2026"

# --- Email (Resend) ---------------------------------------------------------
# Leave empty in development: emails are printed to the server console instead.
RESEND_API_KEY=""
EMAIL_FROM="CCS Sit-In <no-reply@example.com>"

# --- File storage -----------------------------------------------------------
# Vercel Blob token for profile photos in production. Empty = files go to ./uploads (dev).
BLOB_READ_WRITE_TOKEN=""

# --- Scheduled jobs -----------------------------------------------------------
# Protects /api/cron/* (auto-ending sit-ins, reminders…). Generate: openssl rand -hex 32
CRON_SECRET=""
